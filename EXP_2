<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simple News Website</title>
</head>
<body>

  <!-- Header -->
  <header>
    <h1 style="text-align:center;">Global Daily News</h1>
    <p style="text-align:center;">Your Trusted Source for Latest Updates</p>
  </header>

  <hr>

  <!-- Navigation -->
  <nav style="text-align:center;">
    <a href="#world">World</a> |
    <a href="#sports">Sports</a> |
    <a href="#entertainment">Entertainment</a> |
    <a href="#podcast">Podcast</a> |
    <a href="#contact">Contact</a>
  </nav>

  <hr>

  <!-- World News -->
  <section id="world">
    <h2>World News</h2>
    <p>Today’s top headline: Global leaders meet to discuss climate change initiatives.</p>
    <img src="bbc-world-news.png" alt="BBC World News" width="100%">
    <p><a href="https://www.bbc.com/news" target="_blank">Read more on BBC</a></p>
  </section>

  <!-- Sports -->
  <section id="sports">
    <h2>Sports Update</h2>
    <p>Highlights of yesterday’s football match with thrilling last-minute goals!</p>
    <iframe width="100%" height="450"
            src="https://www.youtube.com/embed/aqz-KE-bpKQ"
            title="Big Buck Bunny 60fps 4K - Official Blender Foundation Short Film"
            frameborder="0" allowfullscreen>
    </iframe>
  </section>

  <hr>

  <!-- Entertainment -->
  <section id="entertainment">
    <h2>Entertainment Buzz</h2>
    <p>New movie trailer released today. Fans are excited!</p>
    <video width="100%" controls>
      <source src="trailer.mp4" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </section>

  <hr>

  <!-- Podcast -->
  <section id="podcast">
    <h2>News Podcast</h2>
    <p>Listen to today’s top headlines:</p>
    <audio controls>
      <source src="podcast.mp3" type="audio/mpeg">
      Your browser does not support the audio element.
    </audio>
  </section>

  <hr>

  <!-- Contact -->
  <footer id="contact">
    <h3>Contact Us</h3>
    <p>Email: info@globalnews.com</p>
    <p>&copy; 2025 Global Daily News</p>
  </footer>

</body>
</html>